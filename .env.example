# Copy to .env and fill in. The pipeline runs WITHOUT these (discovery + prune
# work offline; enrichment degrades to a stub) — they just enable real
# grounded enrichment and higher rate limits.

# Grounded enrichment model (Gemini Flash-Lite with Search grounding).
GEMINI_API_KEY=
# Override the model id if needed. Verify the exact id + grounding pricing.
ENRICH_MODEL=gemini-flash-lite-latest

# Optional Socrata app token — not required, just raises DataSF rate limits.
SOCRATA_APP_TOKEN=

# Tuning (all optional; defaults in config.py)
# DISCOVERY_SINCE=2026-01-01
# RECHECK_COMING_SOON_DAYS=7
# OPEN_CONFIDENCE_THRESHOLD=0.7
# ENRICH_LIMIT=            # cap enrichment calls per run while testing
